#!/bin/sh
# Blocks a push whose new file contents match credential-shaped strings.
# Not active until you run: sh scripts/install-hooks.sh
# Git will not set core.hooksPath on clone.

set -eu
root=$(git rev-parse --show-toplevel)
scan="$root/scripts/scan-secrets.sh"
fail=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    files=$(git ls-tree -r --name-only "$local_sha")
  else
    files=$(git diff --name-only "$remote_sha" "$local_sha")
  fi
  for f in $files; do
    case "$f" in
      vendor/*|*.png|*.jpg|*.gif|*.pdf|*.min.js) continue ;;
    esac
    git cat-file -e "$local_sha:$f" 2>/dev/null || continue
    if ! git show "$local_sha:$f" | "$scan" --stdin "$f"; then
      fail=1
    fi
  done
done

exit "$fail"
